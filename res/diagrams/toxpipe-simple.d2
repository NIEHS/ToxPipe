  #   }
  # }
}

aws: "Amazon Web Services" {
  icon: ../images/logos/aws.svg
  bedrock: AWS Bedrock {
    style: {
      font-size: 80
    }
    icon: ../images/logos/amazon_bedrock.svg
    icon.near: "outside-top-left"
    claude: Anthropic/nClaude Models {
      direction: down
      
      opus: Claude 3 Opus {
        shape: image
        icon: ../images/logos/anthropic_opus.svg
      }

      sonnet: Claude 3 Sonnet {
        shape: image
        icon: ../images/logos/anthropic_sonnet.svg
      }

      haiku: Claude 3 Haiku {
        shape: image
        icon: ../images/logos/anthropic_haiku.svg
      }

      claude21: Claude 2.1 {
        shape: image
        icon: ../images/logos/anthropic_opus.svg
        style.fill: "#c56c52"
      }

      claudeInstant: Claude Instant {
        shape: image
        icon: ../images/logos/anthropic_opus.svg
        style.fill: "#c56c52"
      }
    }

    mistral: Mistral AI Models {
      icon: ../images/logos/mistral_ai.svg
      icon.near: "outside-top-left"

      mistralLarge: Mistral Large {
        class: llm
        shape: image
        icon: ../images/logos/mistral_ai_icon.svg
      }

      mistral7bInstruct: Mistral 7B Instruct {
        class: llm
        shape: image
        icon: ../images/logos/mistral_ai_icon.svg
      }

      mistral8x7bInstruct: Mistral 8x7B Instruct {
        class: llm
        shape: image
        icon: ../images/logos/mistral_ai_icon.svg
      }
    }
  }
}

aws.bedrock.claude -> nih.gpuBox.toxpipe.litellm
aws.bedrock.mistral -> nih.gpuBox.toxpipe.litellm

internet {
  label: Internet

  pubmed: "" {
    class: api
    icon: ../images/logos/pubmed-logo.png
    shape: image
  }
  comptox: "Comptox\nDashboard" {
    class: api
    icon: ../images/logos/epa-logo.png
    shape: image
    link: https://comptox.epa.gov/dashboard/
  }
  google: "" {
    icon: ../images/logos/google-logo.png
    shape: image
  }
  pubchem: "" {
    class: api
    icon: ../images/logos/pubchem-logo.png
    shape: image
  }
  semanticScholar: "" {
    class: api
    shape: image
    icon: ../images/logos/semantic_scholar_logo.png
  }
}

*.style.font-size: 100
*.*.style.font-size: 60
*.label.near: "outside-top-center"
*.icon.near: "outside-top-left"

*.style.border-radius: 20

