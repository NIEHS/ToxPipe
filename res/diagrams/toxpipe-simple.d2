...@classes.d2

direction: right

nih {
  label: NIEHS Internal

  posit: "" {
    shape: image
    icon: ../images/logos/posit-connect-logo.svg
  }

  user: Users {
    shape: image
    icon: ../images/logos/user.svg
  }

  user -> gpuBox.toxpipe.traefik

  devs: Developers {
    icon: ../images/logos/user.svg
    shape: image
  }

  storage: Storage {
    class: storage
    models: Model Storage {
      class: models
      icon: ../images/matrix.svg
      shape: image
    }
  }

  # biowulf: "" {
  #   icon: https://hpc.nih.gov/images/BIOWULF_LOGO
  #   style.3d: false
  #   style.shadow: true
  #   style.multiple: false
  #   style.fill: "#232b5f"

  #   training: Model Finetuning {
  #     style.font-color: "#ffffff"
  #     # shape: image
  #     # icon: ../images/logos/fine_tuning.png
  #   }
  # }

  gpuBox: GPU Server {
    class: [server]
    # icon: ../images/logos/


    toxpipe: ToxPipe {
      style: {
        font-size: 70
      }

      traefik {
        class: [docker, reverseProxy]
        shape: image
        icon: ../images/logos/traefikproxy-wordmark.svg
      }

      dashy: Dashy {
        shape: image
        icon: ../images/logos/dashy_logo.png
      }

      librechat: LibreChat {
        class: docker
        shape: image
        icon: ../images/logos/librechat_logo.svg
      }

      mongoDb: "" {
        class: docker
        shape: image
        icon: ../images/logos/mongodb_wordmark.svg
      }

      librechatRag: LibreChat RAG {
        class: docker
      }

      vectorDb: pgvector {
        class: [docker, db]
        shape: image
        icon: ../images/logos/postgresql-wordmark.svg
      }

      meilisearch {
        class: [docker]
        shape: image
        icon: ../images/logos/meilisearch_logo.svg
      }

      litellm: "" {
        class: docker
        shape: image
        icon: ../images/logos/litellm_logo.jpeg
      }

      litellmDb: LiteLLM DB {
        shape: image
        icon: ../images/logos/postgresql-wordmark.svg
      }

      langfuse: "" {
        class: docker
        shape: image
        icon: ../images/logos/langfuse_logo.svg
      }

      langfuseDb: "LangFuse DB" {
        class: docker
        shape: image
        icon: ../images/logos/postgresql-wordmark.svg
      }

      traefik -> dashy
      dashy -> librechat
      dashy -> litellm
      dashy -> langfuse
      litellm <- litellmDb
      litellm -> librechat
      litellm -> langfuse: Logging and Traces
      langfuse <- langfuseDb
      librechatRag <-> vectorDB
      librechat <-> librechatRag
      librechat <-> mongoDb: Conversations
      librechat <-> meilisearch: Conversation Search
      meilisearch <-> mongoDb
    }
  }


}

azure: "Azure" {
  direction: right
  # label: Azure Cloud
  # label.near: outside-top-center
  icon: ../images/logos/azure.svg

  openaiApi: "OpenAI Models" {
