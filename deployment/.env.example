#=====================================================================#
#                 ToxPipe Backend Environment Variables               #
#=====================================================================#

#==================================================#
#               Server Configuration               #
#==================================================#
EXPERIMENTAL_AGENTS=true

# Where LibreChat will run
HOST=0.0.0.0
PORT=3080

# The database connection string for MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/LibreChat

# This is where the LibreChat interface is accessible
DOMAIN_CLIENT=http://localhost:3080 # CHANGEME
DOMAIN_SERVER=http://localhost:3080 # CHANGEME

NO_INDEX=true

# LibreChat Postgres credentials
POSTGRES_USER=postgres # CHANGEME
POSTGRES_PASSWORD=password # CHANGEME
POSTGRES_DB=postgres

# RAG Settings
EMBEDDINGS_PROVIDER=ollama
EMBEDDINGS_MODEL=Losspost/stella_en_1.5b_v5:latest
OPENAI_API_VERSION=2024-02-01
COLLECTION_NAME=librechat

#===============#
# Debug Logging #
#===============#
DEBUG_LOGGING=true
DEBUG_CONSOLE=false

#===================================================#
#                     Endpoints                     #
#===================================================#
PROXY=

#============#
# Azure      #
#============#
EASTUS_API_KEY=key # CHANGEME - Azure OpenAI key for East US
EASTUS2_API_KEY=key # CHANGEME - Azure OpenAI key for East US 2
AZURE_OPENAI_API_KEY=$EASTUS2_API_KEY # most models are hosted on East US 2
AZURE_OPENAI_EMBEDDINGS_API_KEY=$EASTUS2_API_KEY
AZURE_MISTRAL_API_KEY=$EASTUS2_API_KEY
AZURE_LLAMA2_70B_API_KEY=$EASTUS2_API_KEY

#============#
# Google     #
#============#
GOOGLE_MODELS=gemini-2.5-flash,gemini-2.5-pro,gemini-2.0-flash-exp,gemini-1.5-pro-002,gemini-1.5-flash-002,gemini-1.0-pro-vision-001,gemini-1.0-pro-002
GOOGLE_AUTH_JSON_DUMP='{}' # CHANGEME - Google service account JSON as a single line string '{"type": "service_account", "project_id": "your-project-id", ...
GOOGLE_SERVICE_KEY_FILE='{}' # CHANGEME - Google service key file JSON as a single line string 

#============#
# Plugins    #
#============#
DEBUG_PLUGINS=true
CREDS_KEY=key # CHANGEME - Key for encrypting plugin credentials
CREDS_IV=iv # CHANGEME - IV for encrypting plugin credentials

# Azure AI Search - not in use on prod
AZURE_AI_SEARCH_SERVICE_ENDPOINT=
AZURE_AI_SEARCH_INDEX_NAME=
AZURE_AI_SEARCH_API_KEY=
AZURE_AI_SEARCH_API_VERSION=
AZURE_AI_SEARCH_SEARCH_OPTION_QUERY_TYPE=
AZURE_AI_SEARCH_SEARCH_OPTION_TOP=
AZURE_AI_SEARCH_SEARCH_OPTION_SELECT=

# DALL·E
DALLE3_API_KEY=key # CHANGEME
# DALLE3_SYSTEM_PROMPT=
DALLE3_BASEURL=http://localhost # CHANGEME - where the DALL·E API is hosted

# DALL·E (via Azure OpenAI)
DALLE3_AZURE_API_VERSION=2024-02-01

# Google Custom Search
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Stable Diffusion
SD_WEBUI_URL=http://localhost # CHANGEME - where the Stable Diffusion WebUI is hosted

# WolframAlpha
WOLFRAM_APP_ID=xxxx # CHANGEME - WolframAlpha App ID

#==================================================#
#                      Search                      #
#==================================================#
SEARCH=true
MEILI_NO_ANALYTICS=true
MEILI_HOST=http://0.0.0.0:7700
MEILI_MASTER_KEY= # CHANGEME - MeiliSearch master key

#===================================================#
#                    User System                    #
#===================================================#

#========================#
# Moderation             #
#========================#

OPENAI_MODERATION=false
OPENAI_MODERATION_API_KEY=
# OPENAI_MODERATION_REVERSE_PROXY=

BAN_VIOLATIONS=false
BAN_DURATION=1000 * 60 * 60 * 2
BAN_INTERVAL=20

LOGIN_VIOLATION_SCORE=1
REGISTRATION_VIOLATION_SCORE=1
CONCURRENT_VIOLATION_SCORE=1
MESSAGE_VIOLATION_SCORE=1
NON_BROWSER_VIOLATION_SCORE=20

LOGIN_MAX=7
LOGIN_WINDOW=5
REGISTER_MAX=5
REGISTER_WINDOW=60

LIMIT_CONCURRENT_MESSAGES=true
CONCURRENT_MESSAGE_MAX=2

LIMIT_MESSAGE_IP=true
MESSAGE_IP_MAX=40
MESSAGE_IP_WINDOW=1

LIMIT_MESSAGE_USER=false
MESSAGE_USER_MAX=40
MESSAGE_USER_WINDOW=1

ILLEGAL_MODEL_REQ_SCORE=5

#========================#
# Balance                #
#========================#

CHECK_BALANCE=false

#========================#
# Registration and Login #
#========================#
ALLOW_EMAIL_LOGIN=true # Login with email/password
ALLOW_REGISTRATION=true # allow registering with email/password
ALLOW_SOCIAL_LOGIN=false # Login with NIH Account
ALLOW_SOCIAL_REGISTRATION=false # disallow registering with NIH Account

SESSION_EXPIRY=1000 * 60 * 15
REFRESH_TOKEN_EXPIRY=(1000 * 60 * 60 * 24) * 7

JWT_SECRET=secret # CHANGEME
JWT_REFRESH_SECRET=secret # CHANGEME

# OpenID
OPENID_CLIENT_ID=id # CHANGEME
OPENID_CLIENT_SECRET=secret # CHANGEME
OPENID_ISSUER=https://login.microsoftonline.com/xxxx # CHANGEME
OPENID_SESSION_SECRET=some-random-string-of-stuff
OPENID_SCOPE="openid profile email"
OPENID_CALLBACK_URL=/oauth/openid/callback

OPENID_BUTTON_LABEL="Login with NIH Account"
OPENID_IMAGE_URL=

#===================================================#
#                        UI                         #
#===================================================#
APP_TITLE=LibreChat
CUSTOM_FOOTER="Part of NIEHS ToxPipe Platform"
HELP_AND_FAQ_URL=https://docs.toxpipe.niehs.nih.gov

DEBUG_LOGGING=true
DEBUG_CONSOLE=true

# Langfuse
LANGFUSE_AZURE_AD_CLIENT_ID=id # CHANGEME - generate an app registration in Azure AD for use with Langfuse
LANGFUSE_AZURE_AD_CLIENT_SECRET=secret # CHANGEME
LANGFUSE_AZURE_AD_TENANT_ID=id # CHANGEME

# Mistral OCR
OCR_API_KEY=$EASTUS2_API_KEY # CHANGEME - Azure OpenAI key where the OCR model is hosted
OCR_BASEURL=https://localhost # CHANGEME - where the OCR API is hosted

# Ollama for RAG
RAG_API_URL=http://rag_api:8001
EMBEDDINGS_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
EMBEDDINGS_MODEL=nomic-embed-text:latest # whatever model you want to use for RAG embeddings

#===================================================#
#                   LANGFLOW                        #
#===================================================#
# Config directory
# Directory where files, logs and database will be stored
# Example: LANGFLOW_CONFIG_DIR=~/.langflow
LANGFLOW_CONFIG_DIR=/app/langflow

# Save database in the config directory
# Values: true, false
# If false, the database will be saved in Langflow's root directory
# This means that the database will be deleted when Langflow is uninstalled
# and that the database will not be shared between different virtual environments
# Example: LANGFLOW_SAVE_DB_IN_CONFIG_DIR=true
LANGFLOW_SAVE_DB_IN_CONFIG_DIR=

# Database URL
LANGFLOW_DATABASE_URL=postgresql://langflow:langflow@postgres:5438/langflow # CHANGEME

# Cache type
LANGFLOW_LANGCHAIN_CACHE=SQLiteCache

# Server host
# Example: LANGFLOW_HOST=127.0.0.1
LANGFLOW_HOST=

# Worker processes
# Example: LANGFLOW_WORKERS=1
LANGFLOW_WORKERS=

# Server port
# Example: LANGFLOW_PORT=7860
LANGFLOW_PORT=

# Logging level
# Example: LANGFLOW_LOG_LEVEL=critical
LANGFLOW_LOG_LEVEL=

# Path to the log file
# Example: LANGFLOW_LOG_FILE=logs/langflow.log
LANGFLOW_LOG_FILE=

# Path to the frontend directory containing build files
# Example: LANGFLOW_FRONTEND_PATH=/path/to/frontend/build/files
LANGFLOW_FRONTEND_PATH=

# Whether to open the browser after starting the server
# Values: true, false
# Example: LANGFLOW_OPEN_BROWSER=true
LANGFLOW_OPEN_BROWSER=false

# Whether to remove API keys from the projects saved in the database
# Values: true, false
# Example: LANGFLOW_REMOVE_API_KEYS=false
LANGFLOW_REMOVE_API_KEYS=false

# Whether to use RedisCache or ThreadingInMemoryCache or AsyncInMemoryCache
# Values: async, memory, redis
# Example: LANGFLOW_CACHE_TYPE=memory
# If you want to use redis then the following environment variables must be set:
# LANGFLOW_REDIS_HOST (default: localhost)
# LANGFLOW_REDIS_PORT (default: 6379)
# LANGFLOW_REDIS_DB (default: 0)
# LANGFLOW_REDIS_CACHE_EXPIRE (default: 3600)
LANGFLOW_CACHE_TYPE=

# Set AUTO_LOGIN to false if you want to disable auto login
# and use the login form to login. LANGFLOW_SUPERUSER and LANGFLOW_SUPERUSER_PASSWORD
# must be set if AUTO_LOGIN is set to false
# Values: true, false
LANGFLOW_AUTO_LOGIN=false

# Superuser username
# Example: LANGFLOW_SUPERUSER=admin
LANGFLOW_SUPERUSER=admin

# Superuser password
# Example: LANGFLOW_SUPERUSER_PASSWORD=123456
LANGFLOW_SUPERUSER_PASSWORD=password # CHANGEME

# Should store environment variables in the database
# Values: true, false
LANGFLOW_STORE_ENVIRONMENT_VARIABLES=true

# STORE_URL
# Example: LANGFLOW_STORE_URL=https://api.langflow.store
# LANGFLOW_STORE_URL=

# DOWNLOAD_WEBHOOK_URL
#
# LANGFLOW_DOWNLOAD_WEBHOOK_URL=

# LIKE_WEBHOOK_URL
#
# LANGFLOW_LIKE_WEBHOOK_URL=

# Value must finish with slash /
#BACKEND_URL=http://localhost:7860/
BACKEND_URL=

DO_NOT_TRACK=true

# PGAdmin configuration
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin # CHANGEME
