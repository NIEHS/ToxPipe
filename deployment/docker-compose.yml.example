# Do not edit this file directly. Use a ‘docker-compose.override.yaml’ file if you can.
# Refer to `docker-compose.override.yaml.example’ for some sample configurations.

services:

  api:
    container_name: LibreChat
    ports:
      - "${PORT}:${PORT}"
    depends_on:
      - mongodb
      - rag_api
    image: ghcr.io/danny-avila/librechat:v0.8.3
    restart: always
    environment:
      - HOST=0.0.0.0
      - MONGO_URI=mongodb://mongodb:27017/LibreChat
      - MEILI_HOST=http://meilisearch:7700
      - RAG_API_URL=http://rag_api:8000
      - MEILI_NO_SYNC=true
      - ADMIN_USERNAME=${ADMIN_USERNAME:-admin}
      - ADMIN_PASSWORD=${ADMIN_PASSWORD:-password}
      - JWT_SECRET=${JWT_SECRET}

    volumes:
      - ./images:/app/client/public/images
      - ./uploads:/app/uploads
      - ./logs:/app/api/logs
      - ./librechat.yaml:/app/librechat.yaml
    networks:
      - autonomous
    env_file:
      - .env

  mongodb:
    container_name: chat-mongodb
    image: mongo:7.0
    restart: always
    networks:
      - autonomous
    volumes:
      - mongodb-data:/data/db

  mongo-express: 
    image: mongo-express:latest
    container_name: mongo-express
    environment:
      ME_CONFIG_MONGODB_URL: mongodb://mongodb:27017
      ME_CONFIG_BASICAUTH_ENABLED: true 
      ME_CONFIG_BASICAUTH_USERNAME: ${ME_CONFIG_BASICAUTH_USERNAME}
      ME_CONFIG_BASICAUTH_PASSWORD: ${ME_CONFIG_BASICAUTH_PASSWORD}
    ports:
      - '8081:8081'
    depends_on:
      - mongodb
    restart: always
    networks:
      - autonomous

  meilisearch:
    container_name: chat-meilisearch
    image: getmeili/meilisearch:v1.12.3
    restart: always
    networks:
      - autonomous
    environment:
      - MEILI_HOST=http://meilisearch:7700
      - MEILI_NO_ANALYTICS=true
      - MEILI_MASTER_KEY=${MEILI_MASTER_KEY}
    volumes:
      - meili-data:/meili_data

  rag_api: 
    # USE RAG API IMAGE WITH LOCAL EMBEDDINGS SUPPORT
    container_name: rag_api
    image: ghcr.io/danny-avila/librechat-rag-api-dev-lite:v0.7.0
    environment:
      - DB_HOST=vectordb
      - POSTGRES_USER=${VECTORDB_USER} 
      - POSTGRES_PASSWORD=${VECTORDB_PASSWORD}
      - POSTGRES_DB=${VECTORDB_DB}
      - OPENAI_API_BASE=http://litellm:8000
      - OPENAI_API_VERSION=2024-02-01
      - OPENAI_API_KEY=${LITELLM_MASTER_KEY}
    restart: always
    depends_on:
      - vectordb
    networks:
      - autonomous
    env_file:
      - .env

  vectordb:
    container_name: vectordb
    image: pgvector/pgvector:pg16
    environment:
      - POSTGRES_USER=${VECTORDB_USER}
      - POSTGRES_PASSWORD=${VECTORDB_PASSWORD}
      - POSTGRES_DB=${VECTORDB_DB}
    restart: always
    volumes:
      - librechat-pg:/var/lib/postgresql/data
    networks:
      - autonomous

  ollama:
    container_name: ollama
    image: ollama/ollama:0.13.5
    #deploy:
    #  resources:
    #    reservations:
    #      devices:
    #        - driver: nvidia
    #          capabilities: [compute, utility]
              #ports:
              #- 11434:11434
    volumes:
      - ollama:/root/.ollama
    networks:
      - autonomous

  litellm:
    container_name: litellm
    image: ghcr.io/berriai/litellm:main-v1.80.11.rc.1
    volumes:
      - ./.litellm/litellm-config.yaml:/app/config.yaml
    depends_on:
      litellm-db:
        condition: service_healthy
      redis:
        condition: service_healthy
    restart: unless-stopped
    command: >
      --config /app/config.yaml
      --port 8000
      --num_workers ${NUM_WORKERS}    
    environment:
      DATABASE_URL: postgresql://${LITELLM_USER}:${LITELLM_PASSWORD}@litellm-db:5432/${LITELLM_DB}
      AZURE_API_KEY: ${AZURE_API_KEY_LITELLM}
      AZURE_API_BASE: ${AZURE_API_BASE_LITELLM}
      LITELLM_MASTER_KEY: ${LITELLM_MASTER_KEY}
      REDIS_HOST: redis
      REDIS_PASSWORD: ${REDIS_PASSWORD}
      REDIS_URL: redis://:${REDIS_PASSWORD}@redis:6379
      SUCCESS_CALLBACK: ${SUCCESS_CALLBACK}
      LANGFUSE_PUBLIC_KEY: ${LANGFUSE_INIT_PROJECT_PUBLIC_KEY}
      LANGFUSE_SECRET_KEY: ${LANGFUSE_INIT_PROJECT_SECRET_KEY}
      LANGFUSE_HOST: http://langfuse-server:3000
      AWS_ACCESS_KEY_ID: ${AWS_ACCESS_KEY_ID}
      AWS_SECRET_ACCESS_KEY: ${AWS_SECRET_ACCESS_KEY}
      GOOGLE_API_KEY: ${GOOGLE_API_KEY}
    networks:
      - autonomous

  litellm-db:
    image: postgres:16.4
    restart: always
    environment:
      - POSTGRES_USER=${LITELLM_USER}
      - POSTGRES_PASSWORD=${LITELLM_PASSWORD}
      - POSTGRES_DB=${LITELLM_DB}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${LITELLM_USER} -d ${LITELLM_DB}"]    
    volumes:
      - litellm-pg:/var/lib/postgresql/data
    networks:
      - autonomous

  redis:
    # ADD LITELLM CACHING
    image: redis:7-alpine
    command:
    - sh
    - -c # this is to evaluate the $REDIS_PASSWORD from the env
    - redis-server --appendonly yes --requirepass $$REDIS_PASSWORD ## $$ because of docker-compose
    environment:
      - REDIS_PASSWORD=${REDIS_PASSWORD}
    volumes:
      - redis-data:/data
    networks:
      - autonomous
    healthcheck:
      test: ["CMD-SHELL", "redis-cli -a $REDIS_PASSWORD ping"]
      interval: 10s
      timeout: 5s
      retries: 5

  llama-index-mongodb:
    container_name: llama-index-mongodb
    image: mongo:8.2.3
    restart: always
    volumes:
      - llama-index-mongodb-data:/data/db
    networks:
      - autonomous

  chromadb:
    image: ghcr.io/chroma-core/chroma:1.3.0
    container_name: chromadb
    restart: always
    healthcheck:
      test: [ "CMD", "/bin/bash", "-c", "cat < /dev/null > /dev/tcp/localhost/8000" ]
      interval: 30s
      timeout: 3600s
      retries: 5
    volumes:
      - chroma-data:/data
    networks:
      - autonomous

  chromadb-genes:
    image: ghcr.io/chroma-core/chroma:1.0.0
    container_name: chromadb-genes
    restart: always
    healthcheck:
      test: [ "CMD", "/bin/bash", "-c", "cat < /dev/null > /dev/tcp/localhost/8000" ]
      interval: 30s
      timeout: 3600s
      retries: 5
    volumes:
      - chroma-genes-data:/data
    networks:
      - autonomous

  langflow:
    container_name: langflow
    image: langflowai/langflow:1.7.2
    depends_on:
      - postgres-langflow
    environment:
      - LANGFLOW_SUPERUSER=${LANGFLOW_SUPERUSER}
      - LANGFLOW_SUPERUSER_PASSWORD=${LANGFLOW_SUPERUSER_PASSWORD}
      - LANGFLOW_AUTO_LOGIN=false
      - LANGFLOW_DATABASE_URL=postgresql://${LANGFLOW_USER}:${LANGFLOW_PASSWORD}@postgres-langflow:5432/${LANGFLOW_DB}
    ports:
      - "7860:7860"
    restart: always
    volumes:
      - langflow-data:/app/langflow
    networks:
      - autonomous

  postgres-langflow:
    container_name: postgres-langflow
    image: postgres:16
    environment:
      POSTGRES_USER: ${LANGFLOW_USER}
      POSTGRES_PASSWORD: ${LANGFLOW_PASSWORD}
      POSTGRES_DB: ${LANGFLOW_DB}
    restart: always
    volumes:
      - langflow-postgres:/var/lib/postgresql/data
    networks:
      - autonomous

volumes:
  mongodb-data:
  meili-data:
  librechat-pg:
  ollama:
  litellm-pg:
  redis-data:
  llama-index-mongodb-data:
  chroma-data:
  chroma-genes-data:
  langflow-data:
  langflow-postgres:

networks:
  autonomous:
    driver: bridge 
